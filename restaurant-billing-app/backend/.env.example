# ── Database Configuration ────────────────────────────────────────────────
# DB_USER: The PostgreSQL username used to connect to the database (e.g. postgres or sathvikkemtur)
DB_USER=postgres

# DB_PASSWORD: The password for the DB_USER database account
DB_PASSWORD=your_postgres_password

# DB_HOST: Host server address where PostgreSQL is running (localhost means local computer)
DB_HOST=localhost

# DB_PORT: Port number PostgreSQL is listening on (default is 5432)
DB_PORT=5432

# DB_NAME: The name of the specific database to connect to (default: restaurant_billing_db)
DB_NAME=restaurant_billing_db

# PORT: The port the backend server runs on (default: 8000)
PORT=8000

# ── Admin Passwords ────────────────────────────────────────────────────────
# ADMIN_FULL_PASSWORD: Password for full Admin access (reports, void, split bill settings, etc.)
ADMIN_FULL_PASSWORD=SHRIDAR123

# ADMIN_LIMITED_PASSWORD: Password for limited Admin access (like viewing report summaries only)
ADMIN_LIMITED_PASSWORD=SHRIDAR

# ── Printer Configuration ──────────────────────────────────────────────────
# DISABLE_PRINTER_CHECK: Set to 'true' to completely skip checking printer status. Set to 'false' to enforce printer online check.
# If set to true, the application will not block operations even if the printer is disconnected.
DISABLE_PRINTER_CHECK=false

# PRINTER_NAME: The display name of the printer as installed in the OS (e.g., EPSON LQ-310 ESC)
# If this printer is not found, the app will fall back to checking the status of your OS Default Printer.
PRINTER_NAME=EPSON LQ-310 ESC

# PRINTER_SHARE_NAME: The network share name of the printer on Windows (used for raw file copy printing)
# Make sure the printer is shared with this exact name, and that it is accessible.
PRINTER_SHARE_NAME=Generic Text Only

# PRINTER_FEED_LINES: Number of blank lines added to the end of each print job for easy tear-off (e.g., 4)
# Adjust this to change how much paper rolls out at the end of a bill.
PRINTER_FEED_LINES=4

# PRINTER_MEDIA_SIZE: Media size name used by macOS CUPS (e.g., Custom.8.5x3in)
PRINTER_MEDIA_SIZE=Custom.8.5x3in
